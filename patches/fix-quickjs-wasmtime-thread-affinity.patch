+    def _affinity_caller(self) -> str:
+        """Best-effort caller frame for the affinity debug log."""
+        try:
+            import traceback
+
+            frames = traceback.extract_stack()
+            # Skip this frame + the _on_wasmtime_thread frame.
+            if len(frames) >= 3:
+                f = frames[-3]
+                return f"{f.filename}:{f.lineno} in {f.name}"
+        except Exception:
+            pass
+        return "?"
+
+    def _on_wasmtime_thread(self, fn: Callable[[], Any]) -> Any:
+        """Run ``fn`` on the thread that owns this context's Wasmtime
+        store, blocking until it returns.
+
+        The store is not thread-safe (see the affinity note in
+        ``__init__``): a wasm call from the wrong thread raises
+        ``WasmtimeError: An internal error occurred``. The driving
+        loop can migrate across threads (the Deep Agents `task()`
+        bridge awaits on the parent LangGraph loop via
+        ``run_coroutine_threadsafe``), so every store access hops
+        back onto the owning thread.
+
+        Same-thread calls run inline (zero overhead — the common
+        case, where the whole eval stays on the worker thread).
+        Cross-thread calls are serialized onto a single persistent
+        affinity thread via a queue, so the store is always touched
+        by exactly one OS thread for its lifetime.
+        """
+        affinity = self._wasmtime_affinity
+        if affinity is None:
+            return fn()
+        if threading.current_thread() is affinity:
+            return fn()
+        # DIAGNOSTIC: log cross-thread store hops (thread + caller) so a
+        # WasmtimeError can be traced to the exact unwrapped path.
+        try:
+            if os.environ.get("QJS_AFFINITY_DEBUG"):
+                with open("/tmp/qjs_affinity_debug.log", "a") as _df:
+                    _df.write(
+                        f"{time.time():.3f} hop from={threading.current_thread().name} "
+                        f"to=affinity caller={self._affinity_caller()}\n"
+                    )
+        except Exception:
+            pass
+        # Cross-thread: hop onto the persistent affinity thread.
+        with self._wasmtime_affinity_lock:
+            if self._affinity_thread is None or not self._affinity_thread.is_alive():
+                q: "queue.Queue[tuple[Callable[[], Any], list[Any], list[BaseException], threading.Event]]" = queue.Queue()
+                self._affinity_queue = q
+
+                def _affinity_loop() -> None:
+                    while True:
+                        item = q.get()
+                        if item is None:  # poison pill
+                            break
+                        f, box, err, done = item
+                        try:
+                            box.append(f())
+                        except BaseException as e:  # noqa: BLE001
+                            err.append(e)
+                        finally:
+                            done.set()
+
+                t = threading.Thread(target=_affinity_loop, name="quickjs-wasm-affinity", daemon=True)
+                self._affinity_thread = t
+                t.start()
+            q = self._affinity_queue
+        box: list[Any] = []
+        err: list[BaseException] = []
+        done = threading.Event()
+        q.put((fn, box, err, done))
+        done.wait()
+        if err:
+            raise err[0]
+        return box[0] if box else None
